# Privileged systemd host for multi-user install tests (scripts/tests/multiuser/run.sh).
# Its own network namespace keeps TUN devices and policy rules away from the host.
# On Ubuntu hosts (GitHub runners) the host AppArmor profile "unix-chkpwd"
# attaches to the container's unix_chkpwd by path and strips its DAC override
# capabilities, so it cannot read Fedora's mode-0000 shadow files and every
# pam_unix account step (user@.service, systemctl --user -M user@) fails with
# 224/PAM. Owner-readable shadow files need no capability.
FROM fedora:44
# systemd-resolved and polkit, as on desktops: Mihomo's TUN calls resolvectl,
# which polkit must allow silently for each member's own TUN link. glibc lookups
# stay off nss-resolve, so the fake-IP checks still see each user's resolver.
RUN dnf -y install systemd systemd-resolved polkit libcap iproute procps-ng curl shadow-utils \
        util-linux python3 findutils sudo && dnf clean all \
    && sed -i -E 's/ resolve( \[[^]]*\])?//' /etc/nsswitch.conf \
    && systemctl mask getty@tty1.service \
    && useradd -m alice && useradd -m bob && useradd -m carol && useradd -m dave && useradd -m eve && useradd -m frank \
    && chmod 0400 /etc/shadow /etc/gshadow \
    && printf "alice ALL=(ALL) NOPASSWD: ALL\n" > /etc/sudoers.d/mihomo-test-alice \
    && chmod 0440 /etc/sudoers.d/mihomo-test-alice
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
