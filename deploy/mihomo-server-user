#!/usr/bin/env bash
# Control your instance of the shared installation.
set -euo pipefail
umask 077

UNIT=mihomo-server
SLOT_DIR=/var/lib/mihomo-server/slots

usage() {
    cat <<'HELP'
Usage: mihomo-server-user [COMMAND]
  enable      Enable, start and verify your instance (init is an alias)
  start       Start and verify your instance without enabling it at boot
  stop        Stop your instance
  info        Show versions, addresses, paths and TUN state (default command)
  token       Print your management token
  status      Show systemd status
  logs [OPT]  Follow service logs, or pass journalctl options (e.g. -n 100)
  restart     Restart and verify your instance
  disable     Stop and disable your instance, keeping data
  purge --yes Delete your instance data, configuration and slot claim

Edit the displayed env file to configure remote access, then restart.
Subscriptions, nodes, mode and TUN: see mihomo-server --help.
HELP
}
die() { echo "error: $*" >&2; exit 1; }

manager_config_home() {
    # Run inside the manager's environment, which may differ from this terminal.
    # shellcheck disable=SC2016
    systemd-run --user --pipe --wait --collect --quiet /bin/sh -c '
        case "${XDG_CONFIG_HOME:-}" in
            /*) printf "%s\n" "$XDG_CONFIG_HOME" ;;
            *) printf "%s/.config\n" "$HOME" ;;
        esac'
}
paths() {
    local manager_home saved
    manager_home=$(manager_config_home 2>/dev/null) || manager_home="$HOME/.config"
    DROPIN="$manager_home/systemd/user/$UNIT.service.d/10-mihomo-paths.conf"
    CONFIG_HOME="$HOME/.config"
    DATA_HOME="$HOME/.local/share"
    if [ -f "$DROPIN" ]; then
        saved=$(sed -n 's/^# config-home=//p' "$DROPIN")
        [ -z "$saved" ] || CONFIG_HOME=$saved
        saved=$(sed -n 's/^# data-home=//p' "$DROPIN")
        [ -z "$saved" ] || DATA_HOME=$saved
    fi
    # Unset variables reuse saved paths; empty/relative values use XDG defaults.
    if [ "${XDG_CONFIG_HOME+x}" ]; then
        case "$XDG_CONFIG_HOME" in /*) CONFIG_HOME=$XDG_CONFIG_HOME ;; *) CONFIG_HOME="$HOME/.config" ;; esac
    fi
    if [ "${XDG_DATA_HOME+x}" ]; then
        case "$XDG_DATA_HOME" in /*) DATA_HOME=$XDG_DATA_HOME ;; *) DATA_HOME="$HOME/.local/share" ;; esac
    fi
    ENV_FILE="$CONFIG_HOME/mihomo-server/env"
    DATA_DIR="$DATA_HOME/mihomo-server"
    # Let systemd parse its own EnvironmentFile format, including quoted paths.
    # This also resolves explicit data overrides while an instance is stopped.
    if [ -f "$ENV_FILE" ]; then
        local configured
        # shellcheck disable=SC2016
        configured=$(systemd-run --user --pipe --wait --collect --quiet \
            --property="EnvironmentFile=-$ENV_FILE" \
            /bin/sh -c 'printf "%s" "${MIHOMO_SERVER_DATA_DIR:-}"' 2>/dev/null) || configured=''
        case "$configured" in /?*) DATA_DIR=$configured ;; esac
    fi
}

# Quote a systemd assignment/path, including literal percent specifiers.
unit_quote() {
    local value=$1
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die 'paths must not contain newlines'
    value=${value//\\/\\\\}; value=${value//\"/\\\"}; value=${value//%/%%}
    printf '"%s"' "$value"
}
save_paths() {
    local temporary
    mkdir -p "$(dirname "$ENV_FILE")" "$(dirname "$DROPIN")"
    if [ ! -e "$ENV_FILE" ]; then
        (set -o noclobber; cat > "$ENV_FILE" <<'CONFIG'
# Optional settings; changes take effect after mihomo-server restart.
# MIHOMO_SERVER_LISTEN=0.0.0.0:9090
# MIHOMO_SERVER_PUBLIC_ORIGIN=http://server.example:9090
# MIHOMO_SERVER_ARGS=""
CONFIG
        )
    fi
    temporary=$(mktemp "$(dirname "$DROPIN")/.paths-XXXXXX")
    {
        printf '# Managed by mihomo-server-user; user settings belong in the env file.\n'
        printf '# config-home=%s\n# data-home=%s\n[Service]\n' "$CONFIG_HOME" "$DATA_HOME"
        printf 'Environment='; unit_quote "XDG_CONFIG_HOME=$CONFIG_HOME"; printf ' '
        unit_quote "XDG_DATA_HOME=$DATA_HOME"; printf '\nEnvironmentFile=\nEnvironmentFile='
        printf -- '-%s\n' "${ENV_FILE//%/%%}"
    } > "$temporary"
    mv -f "$temporary" "$DROPIN"
}

slot() {
    local n
    for ((n=0; n<64; n++)); do
        if [ -f "$SLOT_DIR/$n" ] && [ "$(stat -c %u "$SLOT_DIR/$n")" = "$(id -u)" ]; then
            echo "$n"; return 0
        fi
    done
    return 1
}
management_port() { if [ "$1" = 0 ]; then echo 9090; else echo $((20000 + 10 * $1)); fi; }
mixed_port() { if [ "$1" = 0 ]; then echo 7890; else echo $((20001 + 10 * $1)); fi; }

current_log() {
    local invocation
    invocation=$(systemctl --user show "$UNIT" -p InvocationID --value)
    [ -n "$invocation" ] || return 0
    journalctl --user "_SYSTEMD_INVOCATION_ID=$invocation" -o cat --no-pager -n 200 2>/dev/null
}
process_value() {
    local pid=$1 key=$2
    [ -r "/proc/$pid/environ" ] || return 0
    tr '\0' '\n' < "/proc/$pid/environ" | sed -n "s/^$key=//p"
}
process_argument() {
    local pid=$1 key=$2
    [ -r "/proc/$pid/cmdline" ] || return 0
    tr '\0' '\n' < "/proc/$pid/cmdline" | awk -v key="$key" '
        next_value {print; exit}
        $0 == key {next_value=1}
        index($0, key "=") == 1 {print substr($0, length(key)+2); exit}'
}
endpoint() {
    local pid origin
    pid=$(systemctl --user show "$UNIT" -p MainPID --value)
    [ "${pid:-0}" != 0 ] || return 1
    LISTEN=$(process_argument "$pid" --listen)
    if [ -z "$LISTEN" ]; then
        local n
        n=$(slot) || return 1
        LISTEN="127.0.0.1:$(management_port "$n")"
    fi
    origin=$(process_argument "$pid" --public-origin)
    AUTHORITY=${origin#*://}; AUTHORITY=${AUTHORITY%/}
    [ -n "$AUTHORITY" ] || AUTHORITY=$LISTEN
    TOKEN_FILE="$(process_argument "$pid" --data-dir)/management-token"
    [ "$TOKEN_FILE" != /management-token ] || TOKEN_FILE="$DATA_DIR/management-token"
    case "$LISTEN" in
        0.0.0.0:*) API_URL="http://127.0.0.1:${LISTEN##*:}" ;;
        '[::]:'*) API_URL="http://[::1]:${LISTEN##*:}" ;;
        *) API_URL="http://$LISTEN" ;;
    esac
    MANAGEMENT_URL=${origin:-$API_URL}
}
# GET PATH, or POST the JSON body given as the second argument.
request() {
    local path=$1 token
    local -a body=()
    token=$(cat "$TOKEN_FILE")
    if command -v curl >/dev/null 2>&1; then
        [ $# = 1 ] || body=(-H 'Content-Type: application/json' --data "$2")
        curl --noproxy '*' -fsS --max-time 2 -H "Host: $AUTHORITY" \
            -H "Authorization: Bearer $token" ${body[@]+"${body[@]}"} "$API_URL$path"
    else
        [ $# = 1 ] || body=(--header='Content-Type: application/json' --post-data="$2")
        wget -q -O - -e use_proxy=no --timeout=2 --tries=1 \
            --header="Host: $AUTHORITY" --header="Authorization: Bearer $token" \
            ${body[@]+"${body[@]}"} "$API_URL$path"
    fi
}
ready() {
    systemctl --user is-active --quiet "$UNIT" || return 1
    endpoint || return 1
    [ -s "$TOKEN_FILE" ] || return 1
    request /api/status 2>/dev/null | grep -Eq '"phase"[[:space:]]*:[[:space:]]*"running"'
}
wait_ready() {
    local tries
    for ((tries=0; tries<60; tries++)); do
        if ready; then return 0; fi
        if ! systemctl --user is-active --quiet "$UNIT"; then break; fi
        sleep 0.5
    done
    current_log | tail -n 20 >&2 || true
    die "$UNIT failed to reach a running core and authenticated API; check configuration and port conflicts"
}
info() {
    local state n tun line detail proxy manage token
    state=$(systemctl --user is-active "$UNIT" 2>/dev/null || true)
    if ! n=$(slot); then
        echo "service:   $state (run: mihomo-server enable)"
        echo "config:    $ENV_FILE"
        return
    fi
    LISTEN="127.0.0.1:$(management_port "$n")"
    TOKEN_FILE="$DATA_DIR/management-token"
    endpoint || true
    manage=${MANAGEMENT_URL:-http://$LISTEN}
    if [ -s "$TOKEN_FILE" ]; then
        token=$(cat "$TOKEN_FILE")
        # Service credentials are 64 hex characters, safe as a URL parameter.
        if [[ "$token" =~ ^[[:xdigit:]]{64}$ ]]; then
            manage="${manage%/}/#token=$token"
        fi
    fi
    line=$(current_log | grep '^multi-user slot ' | tail -n 1 || true)
    # The startup line ends with "(available)", "(available, system-wide)" or "(unavailable: why)".
    detail=${line##* (}; detail=${detail%)}
    case "$detail" in
        available*) tun=${detail//,/} ;;
        *) tun='unavailable (administrator must authorize group mihomo-tun)' ;;
    esac
    proxy=$(mixed_port "$n")
    local actual='' version='' core=''
    if [ "$state" = active ] && [ -s "$TOKEN_FILE" ]; then
        # Report the running processes, which may predate an upgrade on disk.
        version=$(request /api/commands '{"command":"service_version"}' 2>/dev/null |
            sed -nE 's/^"([^"]+)"$/\1/p') || true
        core=$(request /api/status 2>/dev/null |
            sed -nE 's/.*"version"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p') || true
        # /api/config wraps the effective runtime YAML in a JSON string; the
        # top-level key follows the opening quote or an escaped newline.
        actual=$(request /api/config 2>/dev/null |
            sed -nE 's/.*(\\n|")mixed-port:[[:space:]]*([0-9]+).*/\2/p') || true
    elif [ -s "${TOKEN_FILE%/management-token}/settings.yaml" ]; then
        actual=$(sed -nE 's/^[[:space:]]+mixed-port:[[:space:]]*([0-9]+).*/\1/p' \
            "${TOKEN_FILE%/management-token}/settings.yaml" | head -n 1) || true
    fi
    [ -z "$actual" ] || proxy=$actual
    if [ -z "$version" ]; then
        local installed
        installed="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]:-$0}")")/bin/mihomo-server"
        [ ! -x "$installed" ] || version=$("$installed" --version 2>/dev/null | sed -n 's/^mihomo-server //p') || true
    fi
    [ -n "$core" ] || core="unknown (core not running)"
    cat <<DETAILS
service:   $state
version:   ${version:-unknown}
core:      $core
slot:      $n
manage:    $manage
token:     $TOKEN_FILE
proxy:     HTTP/SOCKS 127.0.0.1:$proxy
tun:       $tun (device ms$(id -u))
config:    $ENV_FILE
data:      ${TOKEN_FILE%/management-token}
DETAILS
}
enable() {
    [ $# = 0 ] || die 'enable takes no options; edit your env file instead'
    manager_config_home >/dev/null || die 'cannot connect to your systemd user manager'
    save_paths
    systemctl --user daemon-reload
    [ "$(systemctl --user show -p LoadState --value "$UNIT")" = loaded ] || die 'shared installation is missing'
    systemctl --user enable "$UNIT" >/dev/null
    systemctl --user restart "$UNIT"
    echo "==> waiting for $UNIT to start"
    wait_ready
    info
}
purge() {
    if [ "${1:-}" != --yes ] || [ $# != 1 ]; then die 'purge deletes your data; use purge --yes'; fi
    endpoint || true
    local owned_data=${TOKEN_FILE:-$DATA_DIR/management-token}
    owned_data=${owned_data%/management-token}
    [[ "$owned_data" = /* && "$owned_data" != / && "$owned_data" != "$HOME" ]] || die 'unsafe data directory'
    systemctl --user disable --now "$UNIT"
    local n
    if n=$(slot); then rm -f "$SLOT_DIR/$n"; fi
    rm -rf -- "$owned_data"
    rm -f -- "$ENV_FILE" "$DROPIN"
    systemctl --user daemon-reload
    echo 'Removed your instance data, configuration and slot claim'
}

command=${1:-info}
[ $# = 0 ] || shift
case "$command" in -h | --help | help) usage; exit 0 ;; esac
[ "$(id -u)" != 0 ] || die 'run as the user who owns the instance, not root'
paths
case "$command" in
    enable | init) enable "$@" ;;
    info) info ;;
    token) endpoint || true; cat "${TOKEN_FILE:-$DATA_DIR/management-token}" ;;
    status) exec systemctl --user status "$UNIT" ;;
    logs) if [ $# = 0 ]; then set -- -f; fi; exec journalctl --user -u "$UNIT" "$@" ;;
    start)
        # Record the effective XDG paths once, as enable does, without enabling.
        if [ ! -f "$DROPIN" ]; then save_paths; systemctl --user daemon-reload; fi
        systemctl --user start "$UNIT"; wait_ready; info ;;
    stop) systemctl --user stop "$UNIT"; echo 'Stopped; start again with: mihomo-server start' ;;
    restart) systemctl --user restart "$UNIT"; wait_ready; info ;;
    disable) systemctl --user disable --now "$UNIT"; echo 'Disabled; data kept' ;;
    purge) purge "$@" ;;
    *) die "unknown command: $command (see --help)" ;;
esac
