[Unit]
Description=Headless Mihomo management service
After=network.target

[Service]
Type=simple
EnvironmentFile=-%E/mihomo-server/env
ExecStart=/opt/mihomo-server/current/launch --multi-user $MIHOMO_SERVER_ARGS
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
